# ============================================================
# Dependencies
# ============================================================
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/versions/

# ============================================================
# Build output and generated files
# ============================================================
dist/
build/
out/
coverage/
*.tsbuildinfo

# Vite / bundler caches
.vite/
.turbo/
.parcel-cache/
.esbuild/

# ============================================================
# Environment variables and secrets
# ============================================================
# Ignore all local environment files, but keep the safe template.
.env
.env.*
!.env.example

# Private keys, certificates, and credentials
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.secret

# ============================================================
# Logs and runtime files
# ============================================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*
*.pid
*.pid.lock
*.seed

# ============================================================
# Operating system files
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:*
desktop.ini
$RECYCLE.BIN/

# ============================================================
# IDEs and editors
# ============================================================
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

# ============================================================
# Temporary files and local tooling
# ============================================================
*.tmp
*.temp
*.bak
*.orig
*.rej
*.cache
.temp/
.tmp/
.cache/

# ============================================================
# Test and diagnostic artifacts
# ============================================================
.nyc_output/
playwright-report/
test-results/
*.lcov

# ============================================================
# Local databases and application runtime data
# ============================================================
*.sqlite
*.sqlite3
*.db-journal

# ============================================================
# Notes
# ============================================================
# Intentionally NOT ignored:
# - src/                 application source code
# - public/              application assets and historical media
# - pbcum_website/        preserved original website archive
# - site/                preserved legacy website files
# - metadata.json        project metadata
# - package.json         dependency manifest
# - bun.lock             dependency lockfile
# - .env.example         safe environment-variable template
